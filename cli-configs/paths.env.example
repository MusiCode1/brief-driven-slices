# cli-configs/paths.env.example
#
# תבנית ל-paths.env פר-מכונה. מקור-האמת (agent-definitions/prompts/*.md,
# cli-configs/*, agents/*) ניטרלי-נתיבים לחלוטין ומכיל placeholders בלבד
# ({{BDS_REPORTS}}, {{BDS_SCRIPTS}}, {{BDS_LESSONS}}, {{BDS_ORCH}}).
# install-cli-configs.sh מחליף את ה-placeholders בזמן ההתקנה לפי הערכים כאן.
#
# איך משתמשים:
#   1. העתק קובץ זה ל-~/.config/bds/paths.env (או לנתיב אחר, ואז הגדר
#      BDS_PATHS_ENV=/path/to/paths.env)
#   2. מלא את 4 הנתיבים המוחלטים למכונה שלך
#   3. הרץ: bash scripts/install-cli-configs.sh all
#
# חובה כל 4 המשתנים — install-cli-configs.sh נכשל בכשל-רועש (exit≠0) אם חסר
# אחד מהם (וגם אם לא הוגדרו ישירות ב-env). ניתן גם להגדיר אותם ישירות
# כמשתני-סביבה — env גובר תמיד על הקובץ.

# תיקיית ה-reports (sub-repo פרטי, לא ב-git הציבורי) — לשם נכתבים דוחות
# calev/avigail.
BDS_REPORTS=/abs/path/to/reports-repo

# תיקיית scripts של brief-driven-slices עצמו (dispatch-executor.sh,
# wait-for-slice.sh, cleanup_state.py וכו').
BDS_SCRIPTS=/abs/path/to/brief-driven-slices/scripts

# תיקיית lessons-index (my-skills/lessons-learned/lessons-index).
BDS_LESSONS=/abs/path/to/my-skills/lessons-learned/lessons-index

# תיקיית orchestration (הפרויקט שיתרו רץ ממנו — projects.json, state.json).
BDS_ORCH=/abs/path/to/orchestration
